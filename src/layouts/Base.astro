---
import '../portal.css';
import { ligas } from '../ligas.js';
const { titulo } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{titulo} | Central das Ligas</title>
</head>
<body data-ligas={JSON.stringify(ligas.map(liga => liga.slug))}>
  <header><div class="barra"><a class="marca" href="/">Central<span> das Ligas</span></a><small>FUT7 AMADOR</small><nav aria-label="Principal"><a href="/">Início</a><a href="/#ultimas">Notícias</a><a href="/minha-liga/">Minha Liga</a><a href="/ligas/">Ligas</a><a href="/agenda/">Agenda</a></nav></div></header>
  <main><slot /></main>
  <footer>Central das Ligas · Protótipo editorial</footer>
  <nav class="mobile" aria-label="Menu no celular">
    <a href="/"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m3 10 9-7 9 7v10H3z M9 20v-6h6v6"/></svg>Início</a>
    <a href="/minha-liga/"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"/></svg>Minha Liga</a>
    <a href="/ligas/"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M12 5v14"/><circle cx="12" cy="12" r="3"/></svg>Ligas</a>
    <a href="/agenda/"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M7 3v4m10-4v4M3 10h18m-14 5h3m4 0h3"/></svg>Agenda</a>
    <button id="abrir" aria-haspopup="dialog"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>Menu</button>
  </nav>
  <dialog aria-labelledby="menu-titulo">
    <form method="dialog"><button>Fechar ×</button></form>
    <p class="menu-edicao">CENTRAL DAS LIGAS · FUT7 AMADOR</p><h2 id="menu-titulo">Menu</h2><a href="/">Início</a><a href="/#ultimas">Notícias</a><a href="/minha-liga/">Minha Liga</a><a href="/ligas/">Ligas</a><a href="/agenda/">Agenda</a>
    <a href="/ligas/#tabelas">Tabelas das ligas</a>
  </dialog>
  <script>
    const menu = document.querySelector('dialog');
    const caminho = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('.barra nav a, .mobile a, dialog a').forEach(link => {
      if (!link.hash && (link.pathname === caminho || (link.pathname === '/ligas/' && caminho.startsWith('/ligas/')))) {
        link.setAttribute('aria-current', link.pathname === caminho ? 'page' : 'location');
      }
    });
    try {
      const favorita = localStorage.getItem('giro7:liga-favorita');
      const ligas = JSON.parse(document.body.dataset.ligas ?? '[]');
      if (favorita && ligas.includes(favorita)) {
        document.querySelectorAll<HTMLAnchorElement>(':is(nav, dialog) a[href="/minha-liga/"]').forEach(link => {
          link.href = `/ligas/${favorita}/`;
          if (caminho === link.pathname) {
            link.setAttribute('aria-current', 'page');
            link.parentElement?.querySelector('a[href="/ligas/"]')?.removeAttribute('aria-current');
          }
        });
      }
    } catch {
      // O atalho padrão continua disponível.
    }
    document.querySelector('#abrir')?.addEventListener('click', () => menu?.showModal());
    menu?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => menu.close()));
  </script>
</body>
</html>
